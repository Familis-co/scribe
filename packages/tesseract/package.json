{
  "name": "@familis/scribe-tesseract",
  "version": "0.1.0",
  "description": "Tesseract.js OCR adapter for @familis/scribe",
  "homepage": "https://github.com/familis-co/scribe/tree/main/packages/tesseract#readme",
  "bugs": {
    "url": "https://github.com/familis-co/scribe/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/familis-co/scribe.git",
    "directory": "packages/tesseract"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@familis/scribe": "workspace:^",
    "sharp": "catalog:",
    "tesseract.js": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
