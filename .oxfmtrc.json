{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "ignorePatterns": [
    "dist/**",
    "coverage/**",
    "node_modules/**",
    "pnpm-lock.yaml",
    "fixtures/**",
    ".packages-check/**"
  ]
}
